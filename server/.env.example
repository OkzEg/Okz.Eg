# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Cloudinary (slides + payment receipts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google Drive product photos
GOOGLE_DRIVE_API_KEY=

# Order confirmation emails (SMTP via Gmail). Checkout does not wait on SMTP.
# Example Gmail: host smtp.gmail.com, port 587, use an App Password.
# If 587 hangs on the host, try SMTP_PORT=465 and SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=okzeg3@gmail.com
SMTP_PASS=
# Inbox stays okzeg3@gmail.com — only the visible name changes
MAIL_FROM_NAME=OKZ
MAIL_REPLY_TO=okzeg3@gmail.com

# Seed admin (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
