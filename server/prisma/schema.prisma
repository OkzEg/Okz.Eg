generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  ops
  admin
}

enum ProductType {
  shoe
  belt
  wallet
  bundle
  shoe_lace
  socks
}

enum OrderStatus {
  pending
  confirmed
  out_for_delivery
  delivered
  canceled
  problem
}

enum ProblemStatus {
  open
  in_progress
  resolved
  closed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  passwordHash            String?
  googleId                String?   @unique
  role                    Role      @default(customer)
  phone                   String?
  address                 Json?
  isEmailVerified         Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpires DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  orders           Order[]
  problemRequests  ProblemRequest[] @relation("CustomerProblems")
  createdProblems  ProblemRequest[] @relation("CreatedProblems")
  reviews          Review[]
  cart             Cart?
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String
  price        Decimal     @db.Decimal(10, 2)
  cost         Decimal     @default(1000) @db.Decimal(10, 2)
  type         ProductType
  photos       String[]
  colors       String[]
  sizes        String[]    @default([])
  sizeStock    Json        @default("{}")
  stock        Int         @default(0)
  isSaleActive Boolean     @default(false)
  salePrice    Decimal?    @db.Decimal(10, 2)
  sortOrder    Int         @default(0)
  isBestSeller Boolean     @default(false)
  bestSellerOrder Int      @default(0)
  isHomeProduct Boolean    @default(false)
  homeOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orderItems OrderItem[]
  reviews    Review[]
}

model Slide {
  id            String   @id @default(uuid())
  cloudinaryUrl String
  width         Int?
  height        Int?
  title         String   @default("New Arrival")
  description   String   @default("Shop the collection")
  sortOrder     Int      @default(0)
  placement     String   @default("desktop")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id        String       @id @default(uuid())
  productId String
  userId    String?
  guestName String?
  rating    Int
  comment   String
  photos    String[]     @default([])
  status    ReviewStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Coupon {
  id                 String   @id @default(uuid())
  code               String   @unique
  discountPercentage Int
  isActive           Boolean  @default(true)
  usageCount         Int      @default(0)
  maxUsage           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  status          OrderStatus @default(pending)
  paymentMethod     String
  paymentReceiptUrl String?
  shippingAddress   Json
  itemsPrice        Decimal     @db.Decimal(10, 2)
  shippingPrice     Decimal     @db.Decimal(10, 2) @default(0)
  discountAmount    Decimal     @db.Decimal(10, 2) @default(0)
  totalPrice        Decimal     @db.Decimal(10, 2)
  couponId        String?
  couponCode      String?
  isPaid          Boolean     @default(false)
  paidAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  coupon   Coupon?       @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  problems ProblemRequest[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  qty       Int
  image     String
  price     Decimal @db.Decimal(10, 2)
  cost      Decimal @default(1000) @db.Decimal(10, 2)
  color     String?
  size      String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model FinanceEntry {
  id          String   @id @default(uuid())
  kind        String
  funding     String   @default("company")
  paidBy      String?
  title       String
  notes       String?
  amount      Decimal  @db.Decimal(10, 2)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProblemRequest {
  id          String        @id @default(uuid())
  orderId     String
  customerId  String
  createdById String
  subject     String
  details     String
  status      ProblemStatus @default(open)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  User  @relation("CustomerProblems", fields: [customerId], references: [id])
  createdBy User  @relation("CreatedProblems", fields: [createdById], references: [id])
}

model SiteAsset {
  id            String   @id @default(uuid())
  key           String   @unique
  cloudinaryUrl String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RequestLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  status      Int?
  ip          String?
  forwardedFor String?
  userAgent   String?
  referer     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Cart {
  id                   String    @id @default(uuid())
  userId               String    @unique
  items                Json      @default("[]")
  abandonedEmailSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
